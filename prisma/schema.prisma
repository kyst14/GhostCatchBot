generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   BigInt           @id @unique
  username             String

  connId               String           @unique

  // Statistics
  messagesDeleted      Int              @default(0)
  messagesEdited       Int              @default(0)
  messagesProtected    Int              @default(0)

  chats                Chat[]           @relation("UserChats")
  messages             Message[]
}

model Chat {
  id                   BigInt           @id

  // Statistics
  messagesDeleted      Int              @default(0)
  messagesEdited       Int              @default(0)
  messagesProtected    Int              @default(0)

  lastAccessedAt       DateTime         @default(now())
  expiresAt            DateTime

  users                User[]           @relation("UserChats")
  messages             Message[]

  @@index([expiresAt])
}

model Message {
  id                   Int              @id @default(autoincrement())
  tgId                 BigInt
  type                 MessageType
  content              String
  createdAt            DateTime         @default(now())

  lastAccessedAt       DateTime         @default(now())
  expiresAt            DateTime

  // Foreign keys
  chatId               BigInt
  ownId                BigInt
  senderName           String

  // Relations
  chat                 Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  own                  User             @relation(fields: [ownId], references: [id])

  @@index([chatId])
  @@index([ownId])
  @@index([tgId])
  @@index([expiresAt])
}

enum MessageType {
  TEXT
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  ANIMATION
  STICKER
  VIDEO_NOTE
}

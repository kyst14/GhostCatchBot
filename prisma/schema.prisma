generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   BigInt           @id @unique
  username             String

  connId               String           @unique

  // Statistics
  messagesDeleted      Int              @default(0)
  messagesEdited       Int              @default(0)
  messagesProtected    Int              @default(0)

  chats                Chat[]           @relation("UserChats")
  messages             Message[]
}

model Chat {
  id                   String           @id @default(cuid())
  
  tgId                 BigInt
  ownId                BigInt

  // Statistics
  messagesDeleted      Int              @default(0)
  messagesEdited       Int              @default(0)
  messagesProtected    Int              @default(0)

  lastAccessedAt       DateTime         @default(now())
  expiresAt            DateTime

  own                  User             @relation("UserChats", fields: [ownId], references: [id], onDelete: Cascade)
  messages             Message[]

  @@index([tgId, ownId])
  @@index([expiresAt])

  @@unique([tgId, ownId], name: "tgId_ownId")
}

model Message {
  id                   Int              @id @default(autoincrement())
  tgId                 BigInt
  type                 MessageType
  content              String
  createdAt            DateTime         @default(now())

  lastAccessedAt       DateTime         @default(now())
  expiresAt            DateTime

  tgChatId             BigInt
  ownId                BigInt

  senderName           String

  chat                 Chat             @relation(fields: [tgChatId, ownId], references: [tgId, ownId], onDelete: Cascade)
  own                  User             @relation(fields: [ownId], references: [id])

  @@index([ownId])
  @@index([tgId])
  @@index([expiresAt])

  @@unique([ownId, tgChatId, tgId], name: "own_tg_identity")
}

enum MessageType {
  TEXT
  PHOTO
  VIDEO
  DOCUMENT
  AUDIO
  VOICE
  ANIMATION
  STICKER
  VIDEO_NOTE
}

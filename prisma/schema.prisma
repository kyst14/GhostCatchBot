generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             BigInt           @id @unique
  username       String                 // шифровать

  connId         String           @unique // шифровать

  chats          Chat[]           @relation("UserChats")
  messages       Message[]
}

model Chat {
  id             BigInt           @id

  lastAccessedAt DateTime @default(now())
  expiresAt      DateTime

  users          User[]           @relation("UserChats")
  messages       Message[]
}

model Message {
  id             Int              @id @default(autoincrement())
  tgId           BigInt
  type           MessageType
  content        String             // шифровать
  createdAt      DateTime         @default(now())

  lastAccessedAt DateTime      @default(now())
  expiresAt      DateTime

  // Foreign keys
  chatId         BigInt
  ownId          BigInt
  senderName     String             // шифровать

  // Relations
  chat           Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  own            User             @relation(fields: [ownId], references: [id])
}

enum MessageType {
  TEXT
  MEDIA
}

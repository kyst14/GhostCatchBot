{
	"name": "ghostcatchbot",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "nodemon --exec tsx src/index.ts",
		"build": "bun run build:ts && bun run build:assets",
		"build:ts": "prisma generate && tsc && tsc-alias",
		"build:assets": "cpx \"src/site/**/*\" dist/src/site",
		"start": "node dist/src/index.js",
		"prisma": "bunx prisma generate",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@grammyjs/hydrate": "^1.6.0",
		"@prisma/adapter-neon": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@types/crypto-js": "^4.2.2",
		"@types/express": "^5.0.6",
		"@types/html-escaper": "^3.0.4",
		"@types/node": "^25.9.1",
		"crypto-js": "^4.2.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"grammy": "^1.43.0",
		"html-escaper": "^3.0.3",
		"node-cron": "^4.2.1",
		"ts-node": "^10.9.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"cpx": "^1.5.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.3",
		"prisma": "^7.8.0",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.22.3",
		"typescript-eslint": "^8.60.1"
	}
}

{
  "name": "ghostcatchbot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "bun run build:ts && bun run build:assets",
    "build:ts": "prisma generate && tsc && tsc-alias",
    "build:assets": "cpx \"src/site/**/*\" dist/src/site",
    "start": "node dist/src/index.js",
    "prisma": "bunx prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "seed-owner": "tsx src/seed-owner.ts"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.7.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/html-escaper": "^3.0.4",
    "@types/node": "^25.9.9",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "html-escaper": "^3.0.3",
    "node-cron": "^4.6.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "cpx": "^1.5.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsc-alias": "^1.9.8",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.2"
  }
}
